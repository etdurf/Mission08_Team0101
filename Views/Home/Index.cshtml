@model Mission08_Team0101.Models.ToDoTask

@{
    ViewData["Title"] = (Model?.TaskId > 0) ? "Edit Task" : "Add Task";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card shadow">
                <div class="card-header text-center">
                    <h2 class="mb-0">
                        @(Model.TaskId > 0 ? "Edit Task" : "Add New Task")
                    </h2>
                </div>

                <div class="card-body">
                    <form asp-action="Index" asp-controller="Home" method="post">
                        <input asp-for="TaskId" type="hidden" />

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <!-- Task Name (Required) -->
                        <div class="mb-3">
                            <label asp-for="TaskName" class="form-label fw-bold">Task Name</label>
                            <input asp-for="TaskName" class="form-control" />
                            <span asp-validation-for="TaskName" class="text-danger"></span>
                        </div>

                        <!-- Due Date -->
                        <div class="mb-3">
                            <label asp-for="DueDate" class="form-label fw-bold">Due Date</label>
                            <input asp-for="DueDate" class="form-control" type="date" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>

                        <!-- Quadrant (Required) -->
                        <div class="mb-3">
                            <label asp-for="Quadrant" class="form-label fw-bold"></label>
                            <select asp-for="Quadrant" class="form-select">
                                <option value="">-- Select Quadrant --</option>
                                <option value="1">1 (Important / Urgent)</option>
                                <option value="2">2 (Important / Not Urgent)</option>
                                <option value="3">3 (Not Important / Urgent)</option>
                                <option value="4">4 (Not Important / Not Urgent)</option>
                            </select>
                            <span asp-validation-for="Quadrant" class="text-danger"></span>
                        </div>

                        <!-- Category Dropdown -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                        </div>

                        <!-- Completed -->
                        <div class="form-check mb-3">
                            <input asp-for="Completed" class="form-check-input" />
                            <label asp-for="Completed" class="form-check-label fw-bold"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                @(Model.TaskId > 0 ? "Save Changes" : "Add Task")
                            </button>

                            <a asp-action="Quadrants" asp-controller="Home" class="btn btn-outline-secondary">
                                Back to Quadrants
                            </a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

